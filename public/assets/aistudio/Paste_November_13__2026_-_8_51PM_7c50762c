function drawTree(rootId) {
  if(!rootId) rootId = 'NODE-50001'; currentRootId = rootId;
  $('#searchNodeId').val(rootId.replace('NODE-', ''));
  $('#chart_div').hide(); $('#tree_loading').show().html("<i class='fas fa-spinner fa-spin fs-2'></i><p class='mt-2'>動態讀取組織下線中...</p>");
  
  google.script.run.withSuccessHandler(function(res) {
    if(res.status==='error') { $('#tree_loading').html(`<h5 class='text-danger'>${res.msg || '讀取失敗'}</h5>`); return; }
    if(res.data.length === 0) return $('#tree_loading').html("<h5 class='text-danger'>尚未初始化矩陣資料！</h5>");
    parentOfRoot = res.parentOfRoot; 
    if(parentOfRoot && parentOfRoot !== '無') $('#btnGoUp').fadeIn(); else $('#btnGoUp').fadeOut();
    var data = new google.visualization.DataTable();
    data.addColumn('string', 'Node'); data.addColumn('string', 'Parent'); data.addColumn('string', 'ToolTip');
    data.addRows(res.data);
    var chart = new google.visualization.OrgChart(document.getElementById('chart_div'));
    $('#tree_loading').hide(); $('#chart_div').fadeIn();
    chart.draw(data, {allowHtml: true, allowCollapse: true, size: 'large'});
  }).getMLMTreeData(clientToken, rootId);
}

