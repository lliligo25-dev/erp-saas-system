var $lb = $('#lightbox'), $lbImg = $('#lightbox-img');
function openLightbox(url) { if(!url) return; $lbImg.attr('src', url).removeClass('lb-zoomed').css('transform', 'scale(1)'); $lb.fadeIn(150).css('display','flex'); }
function closeLB(e) { e.stopPropagation(); $lb.fadeOut(150); }
$lbImg.on('click', function(e) { e.stopPropagation(); if (!$(this).hasClass('lb-zoomed')) { var re = this.getBoundingClientRect(); var Xprct = ((e.clientX - re.left) / re.width) * 100; var Yprct = ((e.clientY - re.top) / re.height) * 100; $(this).css('transform-origin', Xprct + '% ' + Yprct + '%').addClass('lb-zoomed').css('transform', 'scale(2.4)'); } else { $(this).removeClass('lb-zoomed').css('transform', 'scale(1)'); }});
