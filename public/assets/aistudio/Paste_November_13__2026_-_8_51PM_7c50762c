$('#f-camera, #f-file').on('change', function() { if(!this.files[0]) return; var r = new FileReader(); r.onload = function(e) { var i = new Image(); i.onload = function() { var c = document.createElement('canvas'); var max = 1000; var rx = i.width > max ? max/i.width : 1; c.width = i.width * rx; c.height = i.height * rx; c.getContext('2d').drawImage(i, 0, 0, c.width, c.height); photoData = c.toDataURL('image/jpeg', 0.65); $('#d-preview').attr('src', photoData).show(); }; i.src = e.target.result; }; r.readAsDataURL(this.files[0]); });
