      let conf = SYS_CONFIG[currentSysType];
      conf.fields.forEach(function(f, idx) {
        if (f.id.includes('姓名') || f.id.includes('品名') || f.id.includes('單位') || f.id.includes('負責人')) $('#d_field_' + idx).val(pendingOrderData.name);
