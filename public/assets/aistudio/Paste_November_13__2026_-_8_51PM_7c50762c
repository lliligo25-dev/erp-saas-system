}

function changeOrderStatus(id, newStatus, event) {
  let item = null; for (var i = 0; i < allData.length; i++) { if (String(allData[i].ID) === String(id)) { item = allData[i]; break; } }
  if(!item) return;

  let $btn = $(event.currentTarget); let originHtml = $btn.html();
  $btn.html('<i class="fas fa-spinner fa-spin me-2"></i>推進中...').prop('disabled', true);

  let ds = { ID: item.ID, photoData: "" };
  SYS_CONFIG[currentSysType].fields.forEach(function(f) { ds[f.id] = item[f.id] || ""; });
  ds['狀態'] = newStatus;
  
  if (ds['開始時間'] !== undefined) ds['開始時間'] = getCurrentDateTimeStr();

  google.script.run.withSuccessHandler(function(res) { drawer.hide(); initData(); }).masterHandler({ token: clientToken, sysType: currentSysType, cmd: 'SAVE', data: ds });
}

function quickCheckout(id, event, hasMoney) {
  let item = null; for (var i = 0; i < allData.length; i++) { if (String(allData[i].ID) === String(id)) { item = allData[i]; break; } }
  if(!item) return;
  
  let ds = { ID: item.ID, photoData: "" };
  SYS_CONFIG[currentSysType].fields.forEach(function(f) { ds[f.id] = item[f.id] || ""; });
  
  if (hasMoney) {
    let moneyField = Object.keys(ds).find(function(k){ return k.includes('金額'); });
    if (moneyField) {
      let amt = prompt('請輸入本次【' + moneyField + '】：', item[moneyField] || "");
      if(amt === null) return;
      let amtNum = parseInt(amt); if(isNaN(amtNum)) { alert("❌ 請輸入有效的數字金額！"); return; }
      ds[moneyField] = amtNum;
    }
  }

  let $btn = $(event.currentTarget); let originHtml = $btn.html();
  $btn.html('<i class="fas fa-spinner fa-spin me-2"></i>處理中...').prop('disabled', true);

  ds['狀態'] = '已完成';
  if (ds['結束時間'] !== undefined) ds['結束時間'] = getCurrentDateTimeStr();

  google.script.run
  .withFailureHandler(function(err) { alert("❌ 結帳失敗: " + err.message); $btn.html(originHtml).prop('disabled', false); })
  .withSuccessHandler(function(res) {
     if(res.status === 'error') { alert("❌ " + res.msg); $btn.html(originHtml).prop('disabled', false); return; }
     alert('✅ 處理成功！'); drawer.hide(); initData();
  }).masterHandler({ token: clientToken, sysType: currentSysType, cmd: 'SAVE', data: ds });
}

