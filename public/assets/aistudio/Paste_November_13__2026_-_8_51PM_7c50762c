// 🌟 1. 處理表單欄位動態顯示/隱藏的專屬函數
function applyDynamicUI() {
  if (currentSysType === 'TCM_T') {
    let status = $('#d_field_0').val();
    
    $('[data-field]').show(); // 先恢復顯示
    
    if (status === '預約中') {
      // 預約中隱藏：開始時間、結束時間、消費金額
      $('[data-field="開始時間"], [data-field="結束時間"], [data-field="消費金額"]').hide();
    } else if (status === '執行中') {
      // 執行中隱藏：預約日期、預約時段
      $('[data-field="預約日期"], [data-field="預約時段"]').hide();
    }
  }
}

// 🌟 2. 修改表單建構，加上 data-field 並綁定 change 事件
function buildDynamicForm(conf) {
  let formHtmlParts = [];
  formHtmlParts.push('<div class="p-3 bg-light rounded border border-light shadow-sm mb-3">');
  formHtmlParts.push('<h6 class="fw-bold mb-3 border-bottom pb-2 text-secondary fs-title"><i class="fas ', conf.fields[0].icon, '"></i> 主分類設定</h6>');
  formHtmlParts.push('<div class="form-floating"><select id="d_field_0" class="form-select border-0 shadow-sm fw-bold">');
  conf.fields[0].options.forEach(function(opt) { formHtmlParts.push('<option value="', opt, '">', opt, '</option>'); });
  formHtmlParts.push('</select><label>', conf.fields[0].label, '</label></div></div>');
  
  let rowOpen = false;
  for(let i=1; i<conf.fields.length; i++) {
    let f = conf.fields[i]; let inputHtml = '';
    if(f.type === 'textarea') { inputHtml = ['<textarea id="d_field_', i, '" class="form-control pt-4 bg-white border-0" placeholder="', f.label, '" style="height:80px"></textarea>'].join(''); } 
    else if(f.type === 'select') {
      let selParts = ['<select id="d_field_', i, '" class="form-select bg-white">'];
      f.options.forEach(function(o) { selParts.push('<option value="', o, '">', o, '</option>'); });
      selParts.push('</select>'); inputHtml = selParts.join('');
    } 
    else { inputHtml = ['<input type="', f.type, '" id="d_field_', i, '" class="form-control bg-white" placeholder="', f.label, '">'].join(''); }
    
    // 👉 在 div 上面掛載 data-field 屬性，讓 applyDynamicUI 可以抓到它
    let wrap = ['<div data-field="', f.id, '" class="', (f.half ? 'col-6' : 'col-12'), ' form-floating mb-3 shadow-sm rounded">', inputHtml, '<label class="ms-2">', f.label, '</label></div>'].join('');
    
    if(f.half) {
      if(!rowOpen) { formHtmlParts.push('<div class="row g-2">'); rowOpen = true; }
      formHtmlParts.push(wrap);
      if (i === conf.fields.length - 1 || !conf.fields[i+1].half) { formHtmlParts.push('</div>'); rowOpen = false; }
    } else { formHtmlParts.push(wrap); }
  }
  $('#dynamic-form-container').html(formHtmlParts.join(''));
  
  // 👉 綁定事件：當狀態切換時，自動觸發隱藏邏輯
  $('#d_field_0').off('change').on('change', applyDynamicUI);
}

function buildDynamicView(item) {
  const conf = SYS_CONFIG[currentSysType];
  let catVal = item[conf.catField] || conf.defaultCat;
  let nameVal = item[conf.nameField] || item['照片標題'] || item['活動主題'] || '未命名';
  
  let viewParts = [];
  viewParts.push('<div class="p-3 bg-light border rounded-3 mb-4 shadow-sm border-opacity-25 border-primary">');
  viewParts.push('<div class="text-primary-emphasis fw-bold text-sm mb-1"><i class="fas ', conf.fields[0].icon, '"></i> 分類屬性</div>');
  viewParts.push('<div class="fw-bold mt-1 fs-title"><span class="text-dark">', nameVal, '</span><span class="badge bg-primary ms-2 shadow-sm align-text-bottom">', catVal, '</span></div>');
  viewParts.push('</div><ul class="list-group list-group-flush mb-4 px-1 fs-title">');
  
  for(let i=2; i<conf.fields.length; i++) {
    let f = conf.fields[i]; let val = item[f.id] || '-';
    if ((f.id.includes('金額') || f.id.includes('價格') || f.id.includes('單價')) && val && val !== '-') val = '<span class="text-danger fw-bold fs-5">NT$ ' + parseInt(val).toLocaleString() + '</span>';
    if(f.type === 'datetime-local' && val && val !== '-') val = val.replace('T', ' ');
    viewParts.push('<li class="list-group-item text-muted text-sm px-0 border-light">', (f.label.split(' ')[1] || f.label), ' <br><span class="text-dark fw-bold ps-4 d-block mt-2 fs-title" style="white-space:pre-wrap;">', val, '</span></li>');
  }
  viewParts.push('</ul>');
  
  let baseSys = currentSysType.split('_')[0]; 
  let isMaster = currentSysType.endsWith('_M');
  let isTrans = currentSysType.endsWith('_T');

  if (isMaster) {
    let photoSafe = item['照片連結'] ? item['照片連結'] : '';
    let targetSys = baseSys + '_T';
    let pPhone = item['手機'] || item['電話'] || '';
    if (SYS_CONFIG[targetSys]) {
      viewParts.push(['<button class="btn btn-primary w-100 fs-title shadow-sm mb-3 py-3 fw-bold" onclick="jumpToTrans(\'', targetSys, '\', \'', nameVal, '\', \'', pPhone, '\', \'', photoSafe, '\')"><i class="fas fa-arrow-circle-right me-2"></i>建立新紀錄 (自動跳轉)</button>'].join(''));
    }
  }

  // 🌟 3. 結帳與推進狀態邏輯 (執行完成 -> 結帳)
  if (isTrans) {
    let isStartable = ['預約中', '待處理', '入庫', '跟進中', '未繳'].includes(catVal);
    let isExecutable = ['執行中', '進行中', '施作中'].includes(catVal);
    let hasMoney = conf.fields.some(function(f){ return f.id.includes('金額'); });

    if (isStartable && SYS_CONFIG[currentSysType].fields.some(function(f){ return f.id === '狀態'; })) {
      let nextState = '執行中';
      if (currentSysType === 'PRODUCT_T') nextState = '已出貨';
      else if (currentSysType === 'GROCERY_T') nextState = '出庫/吃完';
      else if (currentSysType === 'ATOMY_T') nextState = '已成交';
      else if (currentSysType === 'ASSOC_T') nextState = '已繳';
      viewParts.push(['<button class="btn btn-warning text-dark w-100 fs-title shadow-sm mb-3 py-3 fw-bold" onclick="changeOrderStatus(\'', item.ID, '\', \'', nextState, '\', event)"><i class="fas fa-play-circle me-2"></i>開始推進狀態 (自動打卡)</button>'].join(''));
    } else if (isExecutable) {
      // 執行完成的按鈕：因為有 hasMoney=true，點擊後會進入 quickCheckout 結帳！
      let btnText = hasMoney ? '結帳完成 (算入營收)' : '確認完成';
      viewParts.push(['<button class="btn btn-success w-100 fs-title shadow-sm mb-3 py-3 fw-bold" onclick="quickCheckout(\'', item.ID, '\', event, ', hasMoney, ')"><i class="fas fa-check-circle me-2"></i>', btnText, '</button>'].join(''));
    }
  }

  $('#dynamic-view-container').html(viewParts.join(''));
}

function getCurrentDateTimeStr() {
  let now = new Date(); 
  let y = now.getFullYear();
  let m = String(now.getMonth() + 1).padStart(2, '0');
  let d = String(now.getDate()).padStart(2, '0');
  let h = String(now.getHours()).padStart(2, '0');
  let min = String(now.getMinutes()).padStart(2, '0');
  return y + '-' + m + '-' + d + 'T' + h + ':' + min;
}

function jumpToTrans(targetSys, nameStr, phoneStr, photoUrl) {
  drawer.hide();
  pendingOrderData = { name: nameStr, phone: phoneStr, photoUrl: photoUrl };
