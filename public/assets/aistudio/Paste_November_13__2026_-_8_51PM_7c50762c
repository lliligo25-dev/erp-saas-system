function saveData(isContinuous) {
  const conf = SYS_CONFIG[currentSysType];
  var ds = { ID: $('#d-id').val(), photoData: photoData, 傳承照片: inheritedPhoto || "" };
  for(let i=0; i<conf.fields.length; i++) {
    let f = conf.fields[i]; let val = $('#d_field_' + i).val();
    if(f.required && (!val || !val.trim())) { alert('❌ 請填寫必填欄位: ' + f.label.replace('👈*','') + '！'); return; }
    ds[f.id] = typeof val === 'string' ? val.trim() : val;
  }
  localStorage.setItem('actClass_' + currentSysType, ds[conf.fields[0].id]);

  var $btn = isContinuous ? $('#save-continue-btn') : $('#save-btn'); var originalText = $btn.html();
  $btn.html('<i class="fas fa-spin fa-sync-alt me-2"></i>傳輸當中...').prop('disabled',true); $('#save-btn, #save-continue-btn').prop('disabled', true);

  google.script.run
  .withFailureHandler(function(err) { alert("❌ 儲存失敗: " + err.message); $btn.html(originalText); $('#save-btn, #save-continue-btn').prop('disabled', false); })
  .withSuccessHandler(function(res) {
    if (res && res.status === 'error') { alert("❌ 錯誤：" + res.msg); $btn.html(originalText); $('#save-btn, #save-continue-btn').prop('disabled', false); return; }
    photoData = ""; inheritedPhoto = null;
    $btn.html('<i class="fas fa-check-circle me-2"></i>成功！').prop('disabled', false).delay(1000).queue(function(nx){ $(this).html(originalText); $('#save-btn, #save-continue-btn').prop('disabled', false); nx(); });
    if (isContinuous) { 
      conf.fields.forEach(function(f, i) { if(i!==0) $('#d_field_' + i).val(''); }); 
      $('#d-preview').hide(); $('#form-drawer').hide(); $('#drawer-icon').removeClass('fa-chevron-up').addClass('fa-chevron-down'); 
      $('.offcanvas-body').animate({ scrollTop: 0 }, 300); setTimeout(function() { $('#f-camera').click(); }, 350); 
    } else { drawer.hide(); } initData();
  }).masterHandler({ token: clientToken, sysType: currentSysType, cmd: 'SAVE', data: ds });
}

