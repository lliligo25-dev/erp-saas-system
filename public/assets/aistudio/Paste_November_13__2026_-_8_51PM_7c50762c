function initData() {
  google.script.run.withFailureHandler(function(err) {
    $('#loading-hint').html(['<i class="fas fa-exclamation-triangle text-danger fs-1 mb-3"></i><br><h4 class="text-danger fw-bold">系統錯誤: ', err.message, '</h4>'].join(''));
  })
  .withSuccessHandler(function(res) {
    if (res && res.status === 'error') return $('#loading-hint').html(['<i class="fas fa-exclamation-triangle text-danger fs-1 mb-3"></i><br><h4 class="text-danger fw-bold">', res.msg, '</h4>'].join(''));
    $('#loading-hint').hide(); allData = res.data || [];
    
    var rawModules = (res.modules || 'CONTACT').split(',').map(function(m){ return m.trim(); });
    var actualModules = ['ORG_TREE']; 
    rawModules.forEach(function(m) {
      if (m !== 'ORG_TREE') {
        if (SYS_CONFIG[m + '_M']) actualModules.push(m + '_M');
        if (SYS_CONFIG[m + '_T']) actualModules.push(m + '_T');
      }
    });
    
    if($('.sys-toggle').length === 0) buildSideMenu(actualModules);
    if (actualModules.indexOf(currentSysType) === -1 && actualModules.length > 0) return switchSys(actualModules[0]);
    if (currentSysType === 'ORG_TREE') return; 
    
    updateCategoryAndRender(); 
    setImgAspect(currentAspect, $('.aspect-btn[data-ratio="' + (currentAspect === 'detail' ? 'detail' : currentAspect) + '"]')[0], false);
    
    if (pendingOrderData && currentSysType.endsWith('_T')) {
